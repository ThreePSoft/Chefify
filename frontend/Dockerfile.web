# syntax=docker/dockerfile:1.7

FROM debian:bookworm-slim AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    libglu1-mesa \
    python3 \
    unzip \
    xz-utils \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
COPY .flutter-version /tmp/flutter-version
RUN flutter_version="$(tr -d '\r\n' < /tmp/flutter-version)" \
  && curl -fsSL -o flutter-releases.json "https://storage.googleapis.com/flutter_infra_release/releases/releases_linux.json" \
  && release_data="$(python3 -c 'import json, sys; data = json.load(open(sys.argv[1], encoding="utf-8")); release = next((item for item in data["releases"] if item.get("version") == sys.argv[2]), None); assert release, f"Flutter {sys.argv[2]} was not found"; print(release["archive"], release["sha256"])' flutter-releases.json "$flutter_version")" \
  && archive_path="${release_data%% *}" \
  && archive_sha256="${release_data##* }" \
  && curl -fsSL -o flutter.tar.xz "https://storage.googleapis.com/flutter_infra_release/releases/${archive_path}" \
  && printf '%s  %s\n' "$archive_sha256" flutter.tar.xz | sha256sum -c - \
  && tar -xf flutter.tar.xz \
  && rm flutter.tar.xz flutter-releases.json /tmp/flutter-version

ENV PATH="/opt/flutter/bin:${PATH}"
RUN useradd --create-home --shell /bin/bash flutter \
  && chown -R flutter:flutter /opt/flutter

USER flutter
WORKDIR /app
COPY --chown=flutter:flutter pubspec.yaml pubspec.lock ./

RUN git config --global --add safe.directory /opt/flutter \
  && flutter config --enable-web \
  && flutter pub get --enforce-lockfile

COPY --chown=flutter:flutter . .

ARG CHEFIFY_API_BASE_URL=/api
RUN flutter build web --release --no-pub \
  --dart-define=CHEFIFY_API_BASE_URL=${CHEFIFY_API_BASE_URL}

FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
RUN sed -i '1s/^\xEF\xBB\xBF//' /etc/nginx/conf.d/default.conf
COPY --from=build /app/build/web /usr/share/nginx/html

EXPOSE 80
